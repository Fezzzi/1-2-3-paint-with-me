DATABASE_URL=postgres://paint:paint@127.0.0.1:5433/paint_with_me
PORT=3001

# Browser origin allowed to call the API. CLIENT_ORIGIN is still accepted as an alias.
PUBLIC_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Google Identity Services web client id. Verification happens with the public client id.
GOOGLE_CLIENT_ID=

# At least 32 characters in production.
SESSION_SECRET=

# Must be true in production (HTTPS). Leave false for local http://localhost.
COOKIE_SECURE=false

# Local directory for photos, analyses, and thumbnails. Ignored when all four R2
# variables below are set.
UPLOADS_DIR=./uploads

# Cloudflare R2. Leave all four empty for local disk. Setting any one requires the rest.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional. When set, the API serves the built client and falls back to index.html.
STATIC_DIR=

# Local-only sign-in. Refused when NODE_ENV=production.
DEV_LOGIN_ENABLED=false

# Set true behind a reverse proxy so rate limits see the client IP.
TRUST_PROXY=false

LOG_LEVEL=info

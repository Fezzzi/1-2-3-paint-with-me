# Copy to .env.hosted. That file is gitignored.
# pnpm host:up reads it. Fill the API keys, then run the command again.
# Never commit .env.hosted.

FLY_APP=paint-with-me
FLY_REGION=ams

# Neon. Create a key at https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
NEON_PROJECT_ID=
# Written by pnpm host:neon. Frankfurt, pooled, sslmode=require.
DATABASE_URL=

# Cloudflare. Create a token with R2 edit permission.
# Account ID is on the Workers & Pages overview.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# S3 credentials from R2 > Manage API tokens > Object Read & Write.
# R2_ACCOUNT_ID is the same value as CLOUDFLARE_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=paint-with-me

# At least 32 characters. pnpm host:fly generates one when this is empty.
SESSION_SECRET=
# Google Identity Services web client id. The authorized origin is PUBLIC_ORIGIN.
GOOGLE_CLIENT_ID=
# Set after the first Fly app exists, usually https://<fly-app>.fly.dev
PUBLIC_ORIGIN=

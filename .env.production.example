# Production environment for the app container.
# Copy to .env.production and replace every placeholder.
# Never set DEV_LOGIN_ENABLED=true here. The API refuses to start in production when it is true.

NODE_ENV=production
PORT=3001

# Compose uses the `db` service. Hosted deploy uses the Neon URL in .env.hosted instead.
DATABASE_URL=postgres://paint:change-me@db:5432/paint_with_me

# At least 32 characters.
SESSION_SECRET=replace-with-a-long-random-string

# Google Identity Services web client id. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Public origin of the site, including scheme and port. CLIENT_ORIGIN is an alias.
PUBLIC_ORIGIN=https://example.com
CLIENT_ORIGIN=https://example.com

# Required in production. Serve the site over HTTPS.
COOKIE_SECURE=true

# Paths inside the image. Compose mounts a volume at /app/uploads.
# Hosted Fly has no volume: set all four R2 variables and leave uploads unused.
UPLOADS_DIR=/app/uploads
STATIC_DIR=/app/public
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Must be false or unset in production.
DEV_LOGIN_ENABLED=false

# Set true when a reverse proxy sends X-Forwarded-For.
TRUST_PROXY=true

LOG_LEVEL=info
